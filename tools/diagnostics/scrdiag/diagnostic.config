# Merge into the reviewed H753 build configuration; not a complete board config.
CONFIG_SD_SCR_CONTAINMENT_REVIEW=y
CONFIG_STM32H7_SDMMC_IDMA=y
CONFIG_MMCSD_READONLY=y
# CONFIG_MMCSD_MMCSUPPORT is not set
# CONFIG_MMCSD_IOCSUPPORT is not set
# CONFIG_FS_FAT is not set
CONFIG_NSH_DISABLE_MOUNT=y
CONFIG_NSH_DISABLE_UMOUNT=y
# CONFIG_SYSTEM_DD is not set
CONFIG_SD_RECEIVE_LEASE_ONLY_REVIEW=y

# CONFIG_SDMMC_CHECK is not set

# Optional one-shot CMD17 review, disabled by default. Read README first.
# CONFIG_SD_SECTOR_READ_REVIEW is not set
